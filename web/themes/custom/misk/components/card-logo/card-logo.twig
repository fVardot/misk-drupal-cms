{#
/**
 * @file
 * Vartheme BS5 implementation of the Card Logo component.
 *
 * A reusable square logo card with an optional link.
 */
#}

{% set image_src = media.src|default('') %}
{% set image_alt = media.alt|default('') %}
{% set image_width = media.width|default(null) %}
{% set image_height = media.height|default(null) %}
{% set has_url = url is defined and url is not empty %}

{% set card_classes = [
  'card-logo',
  'd-flex',
  'justify-content-center',
  'align-items-center'
] %}

{% set image_classes = [
  'w-100',
  'h-100',
  'object-fit-contain'
] %}

<div{{ attributes.addClass(card_classes) }}>

  {% if has_url %}
    <a
      href="{{ url|e }}"
      class="d-flex justify-content-center align-items-center text-decoration-none w-100 h-100"
      {% if image_alt %}
        aria-label="{{ image_alt|e }}"
      {% endif %}
    >
  {% endif %}

  {% if image_src %}
    <img
      src="{{ image_src|e }}"
      alt="{{ image_alt|e }}"
      {% if image_width %}
        width="{{ image_width|e }}"
      {% endif %}
      {% if image_height %}
        height="{{ image_height|e }}"
      {% endif %}
      class="{{ image_classes|join(' ') }}"
      loading="lazy"
    >
  {% endif %}

  {% if has_url %}
    </a>
  {% endif %}

</div>