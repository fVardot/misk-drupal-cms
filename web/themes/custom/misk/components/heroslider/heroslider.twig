{#
/**
 * @file
 * Heroslider: a Bootstrap 5 carousel with per-slide image + title and custom
 * dot indicators.
 *
 * Available properties:
 * - id: Set a unique id on the heroslider, especially if the page uses multiple hero sliders.
 * - interval: The amount of time (ms) to delay between automatically cycling to the next slide.
 * - touch: Whether the carousel should support left/right swipe interactions on touchscreen devices.
 * - ride: If `true`, autoplays after the user manually cycles the first slide. If `carousel`, autoplays on load.
 * - items: An array of slides, each with an `image` URL and a `title`.
 */
#}

{% set heroslider_id = id ? id : 'heroslider-' ~ random(1000) %}
{% set interval = interval ?? 20000 %}
{% set touch = touch ?? true %}
{% set ride = ride ?? 'carousel' %}

{% if items and items|length >= 1 %}
  <div id="{{ heroslider_id }}" class="hero-carousel carousel slide mb-12 mb-sm-13" data-bs-ride="{{ ride }}" data-bs-interval="{{ interval }}" data-bs-touch="{{ touch ? 'true' : 'false' }}">

    {% if items|length > 1 %}
      <div class="carousel-indicators d-flex justify-content-start mb-5 mb-sm-12 ms-0 me-0">
        <div class="container">
          {% for key, item in items %}
            <button
              type="button"
              data-bs-target="#{{ heroslider_id }}"
              data-bs-slide-to="{{ key }}"
              class="carousel-dot{{ key == 0 ? ' active' : '' }}"
              {% if key == 0 %}aria-current="true"{% endif %}
              aria-label="{{ 'Slide @number'|t({ '@number': key + 1 }) }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="carousel-inner">
      {% for key, item in items %}
        <div class="carousel-item{{ key == 0 ? ' active' : '' }}">
          <div class="carousel-slide w-100 overflow-hidden position-relative">
            {% if item.image %}
              <img src="{{ item.image }}" alt="" class="w-100 h-100 object-fit-cover">
            {% endif %}
          </div>
          <div class="carousel-caption carouselHeader container pt-5 pt-sm-0 text-start start-0 end-0">
            <h1 class="mb-12 text-break">{{ item.title }}</h1>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}